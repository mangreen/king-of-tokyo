# 複製為 .env 後使用；.env 不得提交。以下皆為本機開發用的非機密範例值。

# --- server ---
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
# 允許的前端來源（逗號分隔），用於 CORS / Socket.IO Origin 檢查
ALLOWED_ORIGINS=http://localhost:5173
# 同時存在的房間數上限（防止建立大量房間耗盡記憶體）
MAX_ROOMS=2000
# 同時連線數上限（含大廳）。試玩版 image 預設 30
MAX_CONNECTIONS=10000
# 以下只用於「單一容器」部署（試玩版 image 已在 Dockerfile 設好，本機開發不需要）：
# WEB_DIR=/app/web          # 設定後由伺服器直接提供建置好的網頁
# ALLOW_SAME_ORIGIN=true    # 允許 Origin 與請求 Host 相同的連線
# PORT=8080                 # Cloud Run 注入；SERVER_PORT 優先

# --- postgres（docker compose 使用）---
POSTGRES_USER=kot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=kot
POSTGRES_PORT=5432
# M5 才會實際使用；M0 僅驗證容器可啟動
DATABASE_URL=postgresql://kot:change-me-local-only@localhost:5432/kot

# --- web ---
WEB_PORT=5173
VITE_SERVER_URL=http://localhost:3001
