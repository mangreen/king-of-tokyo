# 複製為 .env 後使用；.env 不得提交。以下皆為本機開發用的非機密範例值。

# --- server ---
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
# 允許的前端來源（逗號分隔），用於 CORS / Socket.IO Origin 檢查
ALLOWED_ORIGINS=http://localhost:5173
# 同時存在的房間數上限（防止建立大量房間耗盡記憶體）
MAX_ROOMS=2000

# --- postgres（docker compose 使用）---
POSTGRES_USER=kot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=kot
POSTGRES_PORT=5432
# M5 才會實際使用；M0 僅驗證容器可啟動
DATABASE_URL=postgresql://kot:change-me-local-only@localhost:5432/kot

# --- web ---
WEB_PORT=5173
VITE_SERVER_URL=http://localhost:3001
